# Copy to .env and edit. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=rocket_forensics

# Auth. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=480

FRONTEND_ORIGIN=http://localhost:5173
# Extra origins, comma-separated (optional)
# CORS_ORIGINS=

MAX_UPLOAD_SIZE_MB=500
STORAGE_DIR=storage

# YOLO (run: python scripts/download_model.py)
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_DEVICE=cpu
# Optional class whitelist, e.g. person,car,truck. Empty = all classes
YOLO_CLASSES=
MAX_SNAPSHOTS_PER_ANALYSIS=200

# Frames analysed per second (presets: fast=1, balanced=2, deep=5 via the API "preset" option)
ANALYSIS_FRAME_RATE=2
MOTION_THRESHOLD=25
MIN_CONTOUR_AREA=500
# MOTION_GAP_SECONDS=2.0
